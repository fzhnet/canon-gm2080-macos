# Copy to .env and set your printer's address:
#     cp docker/.env.example docker/.env
#
# Find it on the printer: Setup -> Device settings -> LAN settings,
# or from your router's DHCP lease table.
PRINTER_IP=192.168.1.50

# Canon's raw print port. Leave as-is unless you know otherwise.
PRINTER_PORT=9100

# Name of the queue inside the bridge container.
QUEUE_NAME=GM2080
